# ==============================================================================
# DevPilot AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and insert your API keys.
# Note: DevPilot AI is 100% functional offline without any keys using built-in
# heuristic ML engines and public APIs.

# Google Gemini API Key (Optional — enables Gemini AI rewrites and audio interview transcription)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional — increases GitHub rate limit from 60 to 5,000 req/hr)
# Generate a token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Firebase Configuration (Optional — enables Cloud Authentication & Firestore Sync across devices)
# 1. Web API Key: Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# 2. Project ID: Firebase Console -> Project Settings -> General -> Project ID
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# 3. Service Account Credentials for Firestore (Choose Option A or Option B):
# Option A: Path to service account JSON file (e.g. serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: Inline service account credentials (useful for Streamlit Cloud deployment)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Production HMAC Session Signing Secret (Required for tamper-proof session persistence in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-32-byte-hex-secret

